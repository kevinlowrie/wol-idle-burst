{
  "id": "wolWakeOnDemand01",
  "name": "Wake on demand (WoL)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wake-on-demand",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Wake request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        160
      ],
      "webhookId": "wol-wake-on-demand"
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "name": "Called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        380
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-wait",
              "name": "wait",
              "value": "={{ $json.query.wait !== \"false\" }}",
              "type": "boolean"
            },
            {
              "id": "cfg-viaWebhook",
              "name": "viaWebhook",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "name": "From webhook",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        160
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-wait",
              "name": "wait",
              "value": "={{ $json.wait !== false && $json.wait !== \"false\" }}",
              "type": "boolean"
            },
            {
              "id": "cfg-viaWebhook",
              "name": "viaWebhook",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "name": "From workflow",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        380
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-mac",
              "name": "mac",
              "value": "4c:ed:fb:91:9d:33",
              "type": "string"
            },
            {
              "id": "cfg-broadcastAddress",
              "name": "broadcastAddress",
              "value": "10.10.10.255",
              "type": "string"
            },
            {
              "id": "cfg-wolPort",
              "name": "wolPort",
              "value": 9,
              "type": "number"
            },
            {
              "id": "cfg-healthUrl",
              "name": "healthUrl",
              "value": "http://10.10.10.100:8088/health",
              "type": "string"
            },
            {
              "id": "cfg-pollSeconds",
              "name": "pollSeconds",
              "value": 10,
              "type": "number"
            },
            {
              "id": "cfg-maxPolls",
              "name": "maxPolls",
              "value": 36,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        270
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.healthUrl }}",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "name": "Already up?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        270
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "up-already",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Up already",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        820,
        270
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-status",
              "name": "status",
              "value": "up",
              "type": "string"
            },
            {
              "id": "cfg-woke",
              "name": "woke",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "cfg-httpCode",
              "name": "httpCode",
              "value": 200,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "name": "Result: already up",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        120
      ]
    },
    {
      "parameters": {
        "macAddress": "={{ $('Config').first().json.mac }}",
        "broadcastAddress": "={{ $('Config').first().json.broadcastAddress }}",
        "port": "={{ $('Config').first().json.wolPort }}",
        "repeatCount": 3,
        "delayBetweenPackets": 200
      },
      "name": "Send magic packet",
      "type": "n8n-nodes-wol.wakeOnLan",
      "typeVersion": 1,
      "position": [
        1040,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "caller-waits",
              "leftValue": "={{ String($('Config').first().json.wait) }}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Caller waits?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1260,
        400
      ]
    },
