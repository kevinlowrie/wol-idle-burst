    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "booted",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Booted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        340
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-status",
              "name": "status",
              "value": "up",
              "type": "string"
            },
            {
              "id": "cfg-woke",
              "name": "woke",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "cfg-httpCode",
              "name": "httpCode",
              "value": 200,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "name": "Result: ready",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2140,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "keep-waiting",
              "leftValue": "={{ $runIndex }}",
              "rightValue": "={{ $('Config').first().json.maxPolls }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Keep waiting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2140,
        440
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-status",
              "name": "status",
              "value": "timeout",
              "type": "string"
            },
            {
              "id": "cfg-woke",
              "name": "woke",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "cfg-httpCode",
              "name": "httpCode",
              "value": 504,
              "type": "number"
            },
            {
              "id": "cfg-hint",
              "name": "hint",
