              "name": "status",
              "value": "wake-sent",
              "type": "string"
            },
            {
              "id": "cfg-woke",
              "name": "woke",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "cfg-httpCode",
              "name": "httpCode",
              "value": 202,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "name": "Result: wake sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1480,
        540
      ]
    },
