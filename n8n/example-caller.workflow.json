{
  "id": "wolExampleCaller01",
  "name": "Example: wake the server, then do a job",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "wolWakeOnDemand01",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "name": "Wake the server",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-up",
              "leftValue": "={{ $json.status }}",
              "rightValue": "up",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Is it up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {},
      "name": "Do the work here",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        -100
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'server did not come up: ' + $json.status }}"
      },
      "name": "Give up",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        100
      ]
    }
  ],
  "connections": {
    "Manual trigger": {
      "main": [
        [
          {
            "node": "Wake the server",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wake the server": {
      "main": [
        [
          {
            "node": "Is it up?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is it up?": {
      "main": [
        [
          {
            "node": "Do the work here",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Give up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
